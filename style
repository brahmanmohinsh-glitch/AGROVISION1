:root{
    --ink:#23301D; --base:#F1EEDD; --card:#FFFFFF;
    --moss:#3F5D3A; --moss-bg:#EAF2E8;
    --soil:#8B5E34; --soil-bg:#EAE4CE;
    --turmeric:#C1771F; --turmeric-bg:#FDF1E4;
    --danger:#B23A2E; --sun:#E0A82E; --sky:#2E6F8E;
    --muted:#B8AE8E;
  }
  *{box-sizing:border-box;}
  html, body{ overflow-x:hidden; }
  body{
    margin:0; min-height:100vh; min-height:100dvh; display:flex; align-items:center; justify-content:center;
    background:#E7E2CC; font-family:'IBM Plex Sans', sans-serif; color:var(--ink);
    padding:24px 0;
  }
  .serif{ font-family:'Fraunces', serif; }
  .phone{
    width:390px; height:820px; max-height:92vh; background:var(--base); border-radius:44px;
    box-shadow:0 40px 80px rgba(23,30,17,.35), 0 2px 0 rgba(255,255,255,.4) inset;
    overflow:hidden; position:relative; border:10px solid var(--ink);
    display:flex; flex-direction:column;
  }

  /* ---- Tablet: 641px–1024px — slightly larger device preview ---- */
  @media (min-width:641px) and (max-width:1024px){
    .phone{ width:440px; height:880px; max-height:90vh; }
  }

  /* ---- Laptop / desktop: >1024px — comfortable centered preview ---- */
  @media (min-width:1025px){
    .phone{ width:400px; height:840px; max-height:88vh; }
    body{ background:radial-gradient(120% 100% at 50% 0%, #EFEADA 0%, #E3DEC8 100%); }
  }

  /* ---- Mobile: <=640px — fill the real screen, no device chrome ---- */
  @media (max-width:640px){
    body{ padding:0; align-items:stretch; justify-content:stretch; background:var(--base); }
    .phone{
      width:100vw; height:100vh; height:100dvh; max-height:none;
      border:none; border-radius:0; box-shadow:none;
    }
    .topbar{ padding-top:calc(14px + env(safe-area-inset-top)); }
    .bottom-nav{ padding-bottom:calc(12px + env(safe-area-inset-bottom)); }
  }

  .scroll{ flex:1; min-height:0; overflow-y:auto; padding-bottom:84px; scroll-behavior:smooth; -webkit-overflow-scrolling:touch; }
  .scroll.no-pad{ padding-bottom:0; }
  .scroll::-webkit-scrollbar{ width:0; }
  .tab-anim{ animation:fadeSlide .28s cubic-bezier(.2,.8,.2,1); }
  @keyframes fadeSlide{ from{ opacity:0; transform:translateY(8px);} to{ opacity:1; transform:translateY(0);} }
  @keyframes popIn{ from{ opacity:0; transform:scale(.94);} to{ opacity:1; transform:scale(1);} }

  /* top bar */
  .topbar{ display:flex; align-items:center; justify-content:space-between; padding:10px 20px 6px; }
  .logo{ display:flex; align-items:center; gap:9px; }
  .logo-mark{ border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0;
    background:linear-gradient(150deg,var(--moss) 0%, var(--turmeric) 100%); color:#fff;
    box-shadow:0 3px 8px rgba(63,93,58,.35); }
  .avatar{ width:34px; height:34px; border-radius:50%; background:var(--moss-bg); color:var(--moss);
    display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13px;
    border:2px solid #fff; box-shadow:0 2px 6px rgba(0,0,0,.08); }

  /* screen header */
  .screen-header{ padding:22px 20px 22px; background:linear-gradient(160deg, var(--moss) 0%, #34502F 100%);
    color:var(--base); border-radius:0 0 32px 32px; position:relative; overflow:hidden; }
  .screen-header::after{ content:""; position:absolute; top:-30px; right:-30px; width:120px; height:120px;
    border-radius:50%; background:rgba(255,255,255,.05); }
  .screen-header h1{ margin:0; font-size:23px; display:flex; align-items:center; gap:10px; letter-spacing:-.2px; position:relative; }
  .screen-header .hicon{ width:34px; height:34px; border-radius:11px; background:rgba(255,255,255,.14);
    display:flex; align-items:center; justify-content:center; font-size:17px; flex-shrink:0; }
  .screen-header p{ margin:6px 0 0 44px; font-size:12.5px; opacity:.82; }
  .sub-header{ padding:22px 20px 20px; background:linear-gradient(160deg, var(--moss) 0%, #34502F 100%);
    color:var(--base); border-radius:0 0 32px 32px; display:flex; align-items:center; gap:12px; }
  .back-btn{ width:34px; height:34px; border-radius:50%; background:rgba(255,255,255,.16); border:none;
    color:#fff; display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:16px;
    transition:background .15s; }
  .back-btn:active{ background:rgba(255,255,255,.3); }

  .content{ padding:0 20px; }
  .mt4{ margin-top:16px; } .mt3{ margin-top:12px; } .mt2{margin-top:8px;} .mt5{margin-top:20px;}

  .card{ background:var(--card); border:1px solid #EFEADA; border-radius:18px; padding:16px;
    box-shadow:0 1px 2px rgba(35,48,29,.03), 0 6px 16px rgba(35,48,29,.05); }
  .row-between{ display:flex; align-items:center; justify-content:space-between; }

  .chip{ font-size:11px; padding:4px 10px; border-radius:999px; font-weight:600; display:inline-flex; align-items:center; gap:4px; white-space:nowrap; }
  .chip-moss{ background:var(--moss-bg); color:var(--moss); }
  .chip-sun{ background:#FCF0D2; color:#8A6A0F; }
  .chip-danger{ background:#FBE7E4; color:var(--danger); }
  .chip-soil{ background:var(--soil-bg); color:#5A4426; }

  .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .action-card{ text-align:left; background:var(--card); border:1px solid #EFEADA; border-radius:18px;
    padding:15px; cursor:pointer; font-family:inherit;
    box-shadow:0 1px 2px rgba(35,48,29,.03), 0 6px 16px rgba(35,48,29,.05);
    transition:transform .12s ease, box-shadow .12s ease; }
  .action-card:active{ transform:scale(.96); box-shadow:0 1px 4px rgba(35,48,29,.06); }
  .action-icon{ width:38px; height:38px; border-radius:12px; display:flex; align-items:center; justify-content:center;
    margin-bottom:11px; font-size:18px; }
  .action-card p.title{ margin:0; font-size:14px; font-weight:600; color:var(--ink); letter-spacing:-.1px; }
  .action-card p.desc{ margin:4px 0 0; font-size:11.5px; color:var(--soil); line-height:1.4; }
  .full-span{ grid-column: 1 / -1; }

  .segmented{ display:flex; gap:6px; background:#E9E4D2; padding:4px; border-radius:999px; }
  .seg-btn{ flex:1; padding:8px 0; border-radius:999px; font-size:13px; font-weight:600; border:none;
    background:transparent; color:var(--soil); cursor:pointer; font-family:inherit; transition:all .15s; }
  .seg-btn.active{ background:#fff; color:var(--moss); box-shadow:0 2px 6px rgba(35,48,29,.08); }

  .pill-btn{ padding:7px 13px; border-radius:999px; font-size:12px; font-weight:600; border:1px solid transparent; cursor:pointer;
    background:var(--base); color:#5A4426; font-family:inherit; transition:all .12s; }
  .pill-btn.active{ background:var(--moss); color:#fff; box-shadow:0 3px 8px rgba(63,93,58,.3); }
  .pill-btn:active{ transform:scale(.95); }

  .btn-primary{ width:100%; padding:14px 0; border-radius:999px; background:var(--turmeric); color:#fff;
    font-size:14.5px; font-weight:700; border:none; cursor:pointer; font-family:inherit;
    box-shadow:0 6px 16px rgba(193,119,31,.35); transition:transform .1s, box-shadow .1s; letter-spacing:.1px; }
  .btn-moss{ width:100%; padding:14px 0; border-radius:999px; background:var(--moss); color:#fff;
    font-size:14.5px; font-weight:700; border:none; cursor:pointer; font-family:inherit;
    box-shadow:0 6px 16px rgba(63,93,58,.3); transition:transform .1s, box-shadow .1s; letter-spacing:.1px; }
  .btn-primary:active, .btn-moss:active{ transform:scale(.98); }
  .btn-primary:disabled, .btn-moss:disabled{ opacity:.35; cursor:not-allowed; box-shadow:none; }
  .btn-soft{ padding:9px 0; border-radius:999px; background:var(--moss-bg); color:var(--moss); font-size:12.5px;
    font-weight:600; border:none; cursor:pointer; font-family:inherit; display:flex; align-items:center; justify-content:center; gap:6px;
    transition:transform .1s; }
  .btn-soft:active{ transform:scale(.96); }

  input[type=text], input[type=number], input[type=tel], select{
    width:100%; border:1.5px solid #EFEADA; border-radius:12px; padding:11px 13px; font-size:14px;
    font-family:inherit; outline:none; background:#FBF9F1; color:var(--ink); transition:border-color .15s;
  }
  input[type=text]:focus, input[type=number]:focus, input[type=tel]:focus, select:focus{ border-color:var(--moss); background:#fff; }
  input[type=range]{ width:100%; -webkit-appearance:none; height:6px; border-radius:999px;
    background:linear-gradient(90deg, var(--turmeric) 0%, var(--turmeric) var(--val,50%), #E9E4D2 var(--val,50%)); }
  input[type=range]::-webkit-slider-thumb{ -webkit-appearance:none; width:20px; height:20px; border-radius:50%;
    background:#fff; border:3px solid var(--turmeric); box-shadow:0 2px 6px rgba(0,0,0,.2); cursor:pointer; }
  label.field-label{ display:block; font-size:12px; font-weight:600; color:var(--soil); margin-bottom:7px; letter-spacing:.1px; }

  .list-row{ display:flex; align-items:center; gap:12px; padding:12px 0; border-bottom:1px solid var(--base); }
  .list-row:last-child{ border-bottom:none; }
  .list-row .rowicon{ width:34px; height:34px; border-radius:11px; display:flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0; }
  .stat-row{ display:flex; align-items:center; justify-content:space-between; padding:9px 0; border-bottom:1px solid var(--base); font-size:13px; }
  .stat-row:last-child{ border-bottom:none; }

  .bottom-nav{ position:absolute; left:0; right:0; bottom:0; background:rgba(255,255,255,.92); backdrop-filter:blur(10px);
    border-top:1px solid #EFEADA; display:flex; padding:10px 6px 12px; }
  .nav-btn{ flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; padding:4px 0;
    background:none; border:none; cursor:pointer; font-family:inherit; }
  .nav-btn .icon-wrap{ width:38px; height:26px; border-radius:13px; display:flex; align-items:center; justify-content:center;
    transition:background .18s; }
  .nav-btn.is-active .icon-wrap{ background:var(--moss-bg); }
  .nav-btn .icon{ font-size:16px; line-height:1; }
  .nav-btn .lbl{ font-size:10px; font-weight:600; }

  .stock-tag{ font-size:11px; background:var(--base); color:#5A4426; padding:3px 9px; border-radius:999px; font-weight:500; }
  .upload-box{ aspect-ratio:1/1; border-radius:16px; background:linear-gradient(160deg,#F7F4E8,#EFEADA);
    border:1.5px dashed #C9BF9B; display:flex; align-items:center; justify-content:center; cursor:pointer;
    overflow:hidden; text-align:center; color:var(--soil); transition:border-color .15s; }
  .upload-box:hover{ border-color:var(--turmeric); }
  .upload-box img{ width:100%; height:100%; object-fit:cover; animation:popIn .25s ease; }

  .gauge-bar{ flex:1; height:9px; border-radius:999px; background:var(--base); overflow:hidden; }
  .gauge-fill{ height:100%; border-radius:999px; transition:width .3s ease; }

  .toggle{ width:46px; height:26px; border-radius:999px; border:none; cursor:pointer; position:relative; background:#D8D2BA; transition:background .2s; }
  .toggle.on{ background:var(--moss); }
  .toggle .knob{ position:absolute; top:3px; left:3px; width:20px; height:20px; border-radius:50%; background:#fff;
    transition:left .2s cubic-bezier(.4,0,.2,1); box-shadow:0 1px 3px rgba(0,0,0,.25); }
  .toggle.on .knob{ left:23px; }

  /* splash & login */
  .splash{ flex:1; min-height:0; display:flex; flex-direction:column; align-items:center; justify-content:space-between;
    padding:50px 32px 40px; position:relative; overflow:hidden;
    background:radial-gradient(120% 90% at 50% 0%, #F8F5E9 0%, #F1EEDD 55%, #EDE8D3 100%); }
  .splash .blob1{ position:absolute; top:-40px; right:-40px; width:180px; height:180px; border-radius:50%; background:#3F5D3A12; }
  .splash .blob2{ position:absolute; bottom:-70px; left:-60px; width:240px; height:240px; border-radius:50%; background:#C1771F18; }
  .splash .blob3{ position:absolute; top:40%; left:-40px; width:100px; height:100px; border-radius:50%; background:#E0A82E14; }
  .splash-badge{ width:104px; height:104px; border-radius:32px; display:flex; align-items:center; justify-content:center;
    margin-bottom:26px; box-shadow:0 16px 32px rgba(63,93,58,.28); background:linear-gradient(150deg,var(--moss),var(--turmeric));
    font-size:46px; animation:popIn .4s cubic-bezier(.2,.9,.3,1.2); }
  .splash h1{ margin:0; font-size:36px; letter-spacing:-.5px; }
  .splash .tagline{ font-size:14px; color:var(--soil); margin:8px 0 0; font-weight:500; }
  .splash .desc{ font-size:13.5px; color:#5A4426; margin-top:18px; max-width:250px; line-height:1.5; }
  .dots{ display:flex; gap:6px; margin:22px 0 0; }
  .dots span{ width:6px; height:6px; border-radius:50%; background:#D8D2BA; }
  .dots span:first-child{ width:20px; border-radius:999px; background:var(--turmeric); }

  .login-wrap{ flex:1; min-height:0; overflow-y:auto; display:flex; flex-direction:column; padding:36px 26px 34px;
    background:radial-gradient(120% 60% at 50% 0%, #F8F5E9 0%, #F1EEDD 60%); }
  .login-logo{ display:flex; flex-direction:column; align-items:center; margin-bottom:34px; }
  .phone-input-row{ display:flex; align-items:center; background:#FBF9F1; border:1.5px solid #EFEADA; border-radius:14px;
    padding:13px 15px; margin-bottom:18px; transition:border-color .15s; }
  .phone-input-row:focus-within{ border-color:var(--moss); background:#fff; }
  .phone-input-row span{ font-size:14.5px; color:#5A4426; font-weight:600; padding-right:12px; border-right:1.5px solid #EFEADA; margin-right:12px; }
  .phone-input-row input{ border:none; outline:none; flex:1; font-size:15.5px; background:transparent; letter-spacing:.4px; }
  .otp-row{ display:flex; gap:11px; justify-content:center; margin-bottom:26px; }
  .otp-box{ width:50px; height:58px; text-align:center; font-size:21px; font-weight:700; border-radius:14px;
    border:1.5px solid #EFEADA; background:#FBF9F1; outline:none; transition:all .15s; }
  .otp-box:focus{ border-color:var(--moss); background:#fff; box-shadow:0 0 0 4px rgba(63,93,58,.1); }
  .footnote{ font-size:11px; color:var(--soil); text-align:center; margin-top:auto; line-height:1.5; }