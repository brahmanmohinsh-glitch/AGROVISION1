function renderIrrigation(){
  const on = S.irrigation.alertsOn;
  return `
    <div class="card row-between mt4" style="margin-top:0;">
      <div style="display:flex;align-items:center;gap:8px;">
        <span>${on?"🔔":"🔕"}</span><p style="margin:0;font-size:13px;font-weight:500;">Irrigation alerts</p>
      </div>
      <button class="toggle ${on?'on':''}" onclick="toggleAlerts()"><span class="knob"></span></button>
    </div>
    <div class="mt4" style="display:flex;flex-direction:column;gap:12px;">
      ${S.irrigation.fields.map(f=>{
        const low = f.moisture < f.threshold;
        return `<div class="card">
          <div class="row-between" style="margin-bottom:8px;">
            <p style="margin:0;font-size:13px;font-weight:500;">${f.name}</p>
            ${ (low && on) ? chip("⚠️ Irrigate now","danger") : chip("On track","moss") }
          </div>
          <div style="display:flex;align-items:center;gap:10px;">
            <span>📊</span>
            <div class="gauge-bar"><div class="gauge-fill" style="width:${f.moisture}%;background:${low?'var(--danger)':'var(--moss)'};"></div></div>
            <span style="font-size:12px;color:var(--soil);width:36px;text-align:right;">${f.moisture}%</span>
          </div>
          <p style="margin:8px 0 0;font-size:11px;color:var(--soil);">Threshold ${f.threshold}% · ${low ? "irrigate within 6 hrs" : "next check in "+Math.max(1,Math.round((f.moisture-f.threshold)/3))+"h"}</p>
        </div>`;
      }).join("")}
    </div>
  `;
}

