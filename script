function waterPlant(id){ const p = S.plants.find(x=>x.id===id); if(p) p.lastWatered = 0; render(); }
function setScanMode(m){ S.scanMode = m; S.scanResult = null; S.scanImg = null; render(); }
function onFile(evt){
  const f = evt.target.files[0]; if (!f) return;
  const reader = new FileReader();
  reader.onload = () => {
    S.scanImg = reader.result; S.scanResult = null;
    document.getElementById("uploadBox").innerHTML = `<img src="${S.scanImg}">`;
    document.getElementById("analyzeBtn").disabled = false;
  };
  reader.readAsDataURL(f);
}
function analyze(){
  S.scanBusy = true; render();
  setTimeout(()=>{
    if (S.scanMode === "diagnose"){
      S.scanResult = { type:"diagnose", data: DIAGNOSES[Math.floor(Math.random()*DIAGNOSES.length)] };
    } else {
      S.scanResult = { type:"identify", data: ENCYCLOPEDIA[Math.floor(Math.random()*ENCYCLOPEDIA.length)] };
    }
    S.scanBusy = false; render();
  }, 1200);
}
function setFarmSection(s){ S.farmSection = s; render(); }
function setCropField(field, val){ S.crop[field] = val; render(); }
function onPhInput(el){
  S.crop.ph = parseFloat(el.value);
  document.getElementById("phVal").textContent = S.crop.ph.toFixed(1);
  el.style.setProperty("--val", ((S.crop.ph-4)/5*100).toFixed(0)+"%");
}
function predictCrop(){
  const {soil, ph, rain, season} = S.crop;
  const scored = CROP_DB.map(c=>{
    let score = 0;
    if (c.soils.includes(soil)) score += 40;
    const [lo,hi] = c.ph;
    if (ph >= lo && ph <= hi) score += 30; else score += Math.max(0, 30 - Math.abs(ph - (ph<lo?lo:hi))*12);
    if (c.rain === rain) score += 20;
    if (c.season === season) score += 10;
    return {...c, score: Math.round(Math.min(score,100))};
  }).sort((a,b)=>b.score-a.score);
  S.cropResults = scored.slice(0,4);
  document.getElementById("cropResults").innerHTML = renderCropResults();
}
