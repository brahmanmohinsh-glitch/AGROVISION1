function renderScanResult(){
  if (!S.scanResult) return "";
  if (S.scanResult.type === "diagnose"){
    const d = S.scanResult.data;
    const tone = d.severity==="Severe"?"danger":(d.severity==="Mild"?"moss":"sun");
    return `<div class="card mt4">
      <div class="row-between mt2" style="margin-bottom:8px;">
        <p style="margin:0;font-weight:600;">${d.name}</p>
        ${chip(d.severity+" · "+d.conf+"% match", tone)}
      </div>
      <p style="margin:0 0 8px;font-size:12px;color:var(--soil);">Common on: ${d.host}</p>
      <p style="margin:0 0 12px;font-size:13px;">${d.symptoms}</p>
      <div style="background:var(--moss-bg);border-radius:12px;padding:10px;margin-bottom:8px;">
        <p style="margin:0 0 4px;font-size:12px;font-weight:600;color:var(--moss);">Organic treatment</p>
        <p style="margin:0;font-size:12px;">${d.organic}</p>
      </div>
      <div style="background:var(--turmeric-bg);border-radius:12px;padding:10px;margin-bottom:12px;">
        <p style="margin:0 0 4px;font-size:12px;font-weight:600;color:var(--turmeric);">Chemical treatment</p>
        <p style="margin:0;font-size:12px;">${d.chemical}</p>
      </div>
      <button class="btn-moss" onclick="setTab('stores')">🏬 Find pesticide near me</button>
    </div>`;
  } else {
    const e = S.scanResult.data;
    return `<div class="card mt4">
      <p style="margin:0 0 2px;font-weight:600;">✅ ${e.name}</p>
      <p style="margin:0 0 8px;font-size:12px;font-style:italic;color:var(--soil);">${e.latin}</p>
      <div style="display:flex;gap:8px;margin-bottom:8px;">${chip("💧 "+e.water,"soil")} ${chip("☀️ "+e.light,"soil")}</div>
      <p style="margin:0;font-size:12px;color:#5A4426;">${e.note}</p>
    </div>`;
  }
}

